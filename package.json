{
  "name": "@liucxu/dsh-helper",
  "version": "0.2.1",
  "description": "DeepSeek Harness plugin for provider balances, token usage and cost estimates, plus desktop notifications for approvals, questions and completed turns.",
  "license": "MIT",
  "author": "liuchaoxu <ischaoxu@163.com>",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/http.js",
    "lib/model-usage.js",
    "lib/reminding.js",
    "lib/usage-ledger.js",
    "lib/client.js",
    "lib/model-usage.client.js",
    "lib/reminding.client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/screenshots/",
    "scripts/",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/BRAND.md",
    "docs/PUBLISHING.md"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check": "node scripts/check.mjs",
    "test:host": "node scripts/test-host.mjs",
    "test:client": "node scripts/test-client.mjs",
    "test": "npm run build:client && npm run check && npm run test:host && npm run test:client && npm run test:regressions",
    "verify": "npm test && npm run pack:check",
    "pack:check": "npm run build:client && npm run check && node scripts/check-pack.mjs",
    "prepack": "npm run build:client && npm run check",
    "prepublishOnly": "npm test",
    "test:regressions": "node scripts/test-regressions.mjs",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.5": "compatible"
      }
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuchaoxu/dsh-assistant-suite.git"
  },
  "homepage": "https://github.com/liuchaoxu/dsh-assistant-suite#readme",
  "bugs": {
    "url": "https://github.com/liuchaoxu/dsh-assistant-suite/issues"
  },
  "keywords": [
    "dsh-helper",
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "llm",
    "token-usage",
    "token-tracking",
    "cost-tracking",
    "api-usage",
    "api-balance",
    "quota",
    "balance",
    "spending-history",
    "desktop-notifications",
    "reminder",
    "commandcode",
    "openrouter",
    "moonshot",
    "kimi",
    "siliconflow",
    "new-api",
    "cc-switch"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
